{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aikit-opencode": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "--locked",
        "--no-dev",
        "--extra",
        "mcp",
        "python",
        "${PLUGIN_ROOT}/skills/delegating-to-opencode/scripts/mcp_server.py"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
