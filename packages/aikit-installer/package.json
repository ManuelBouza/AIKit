{
  "name": "@manuelbouza/aikit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Instalador de preferencias globales AIKit para Codex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManuelBouza/AIKit.git",
    "directory": "packages/aikit-installer"
  },
  "private": true,
  "type": "module",
  "bin": {
    "aikit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"*.mjs\" \"*.json\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \"*.mjs\" \"*.json\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "templates"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
